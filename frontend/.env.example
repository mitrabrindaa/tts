# Environment variables needed to connect to the LiveKit server.
# Use the same LiveKit Cloud project as the Python agent.
LIVEKIT_API_KEY=<your_api_key>
LIVEKIT_API_SECRET=<your_api_secret>
LIVEKIT_URL=wss://<project-subdomain>.livekit.cloud

# Agent dispatch (https://docs.livekit.io/agents/server/agent-dispatch)
# Must match agent_name in agent/main.py
AGENT_NAME=codeswitch-report-agent

# Sarvam AI — scanned-PDF OCR (Document AI / Vision). Same key as the Python agent STT/TTS.
SARVAM_API_KEY=your_sarvam_api_key

# Internally used environment variables
NEXT_PUBLIC_APP_CONFIG_ENDPOINT=
SANDBOX_ID=
